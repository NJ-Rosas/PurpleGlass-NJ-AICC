# Synthetic local-development values only. Copy to .env to override defaults.
POSTGRES_DB=purpleglass
POSTGRES_USER=purpleglass
POSTGRES_PASSWORD=purpleglass_dev_only
POSTGRES_PORT=5433
MQTT_PORT=1883
VALKEY_PORT=6379

# Browser security boundary. Development identities are predefined server-side.
Security__AllowDevelopmentAuthentication=true
Security__AllowSyntheticDataOnly=true
Providers__EnableRealTelephony=false
Providers__EnableRealAI=false
Providers__EnableRealSpeech=false
Integrations__EnableOpenDental=false
DataProtection__AllowSensitiveData=false

# Provider-neutral simulator settings (synthetic values only).
CallOrchestrator__Conversation__Language=en-US
CallOrchestrator__Conversation__VoiceId=calm-a
CallOrchestrator__Conversation__MaximumTurns=6
CallOrchestrator__RecognitionTimeout=00:00:02
CallOrchestrator__AiTimeout=00:00:02
CallOrchestrator__SynthesisTimeout=00:00:02
CallOrchestrator__MockAi__FailGeneration=false
CallOrchestrator__MockSpeech__FailRecognition=false
CallOrchestrator__MockSpeech__FailSynthesis=false

# Realtime voice defaults. Fake mode needs no external credentials.
SpeechToText__Provider=Fake
LanguageModel__Provider=Fake
TextToSpeech__Provider=Fake
Voice__Conversation__Language=en-US
Voice__Conversation__VoiceId=alloy
Voice__Conversation__SpeakingRate=1.0
Voice__Conversation__MaximumTurns=30
Voice__Conversation__MaximumDuration=00:30:00
Voice__Conversation__MaximumOutputTokens=160
Voice__Conversation__MaximumResponseCharacters=400
Voice__Conversation__InactivityTimeout=00:00:30
Voice__EndOfUtteranceSilence=00:00:00.500
Voice__RecognitionTimeout=00:00:15
Voice__LanguageModelTimeout=00:00:15
Voice__SynthesisTimeout=00:00:15

# Optional Development-only OpenAI path. Store a real key in user-secrets or
# an environment variable; never commit it. Set both relevant real-provider
# switches and provider selectors explicitly when enabling this path.
OpenAI__ApiKey=
OpenAI__BaseUrl=https://api.openai.com/v1/
OpenAI__LanguageModel=gpt-4o-mini
OpenAI__TranscriptionModel=gpt-4o-mini-transcribe
OpenAI__SpeechModel=gpt-4o-mini-tts

# Optional OpenTelemetry export. Applications remain healthy when export is disabled/unavailable.
Observability__Enabled=true
Observability__Otlp__Enabled=false
Observability__Otlp__Endpoint=http://localhost:4317
Observability__Environment=Development
# Telephony is disabled by default. Store real values in user-secrets or a secret manager.
Telephony__Provider=None
Telephony__PublicBaseUrl=
Telephony__Twilio__AccountSid=
Telephony__Twilio__AuthToken=
