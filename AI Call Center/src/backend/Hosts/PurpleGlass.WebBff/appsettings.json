{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Security": {
    "AllowDevelopmentAuthentication": false,
    "AllowSyntheticDataOnly": true,
    "RequireHttps": true,
    "CookieName": "__Host-PurpleGlass.Session",
    "SessionMinutes": 30,
    "ProductionOrigin": "",
    "DataProtectionKeysPath": "",
    "DevelopmentOrigins": [],
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/signin-oidc"
    }
  },
  "Providers": {
    "EnableRealTelephony": false,
    "EnableRealAI": false,
    "EnableRealSpeech": false
  },
  "Telephony": {
    "Provider": "None",
    "PublicBaseUrl": "",
    "InboundMessage": "Thank you for calling. PurpleGlass call transport is connected.",
    "OutboundMessage": "PurpleGlass call transport is connected.",
    "Twilio": {
      "AccountSid": "",
      "AuthToken": ""
    }
  },
  "Integrations": {
    "EnableOpenDental": false
  },
  "DataProtection": {
    "AllowSensitiveData": false
  }
}
