{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Security": {
    "AllowDevelopmentAuthentication": false,
    "AllowSyntheticDataOnly": true,
    "RequireHttps": true,
    "CookieName": "__Host-PurpleGlass.Session",
    "SessionMinutes": 30,
    "ProductionOrigin": "",
    "DataProtectionKeysPath": "",
    "DevelopmentOrigins": [],
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/signin-oidc"
    }
  },
  "Providers": {
    "EnableRealTelephony": false,
    "EnableRealAI": false,
    "EnableRealSpeech": false
  },
  "SpeechToText": {
    "Provider": "Fake"
  },
  "LanguageModel": {
    "Provider": "Deterministic"
  },
  "TextToSpeech": {
    "Provider": "Fake"
  },
  "OpenAI": {
    "BaseUrl": "https://api.openai.com/v1/",
    "ApiKey": "",
    "LanguageModel": "gpt-4o-mini",
    "TranscriptionModel": "gpt-4o-mini-transcribe",
    "SpeechModel": "gpt-4o-mini-tts"
  },
  "Voice": {
    "Enabled": true,
    "RecognitionTimeout": "00:00:15",
    "LanguageModelTimeout": "00:00:15",
    "SynthesisTimeout": "00:00:15",
    "CleanupTimeout": "00:00:03",
    "EndOfUtteranceSilence": "00:00:00.500",
    "MaximumUtteranceDuration": "00:00:20",
    "MinimumSpeechDuration": "00:00:00.120",
    "MaximumSpeechCandidateDuration": "00:00:00.300",
    "SpeechEnergyThreshold": 500,
    "SpeechContinuationThresholdRatio": 0.70,
    "SpeechStartSnrMultiplier": 3.0,
    "MinimumSpeechLikeFrameRatio": 0.50,
    "AudioQueueCapacity": 100,
    "UtteranceQueueCapacity": 4,
    "MaximumAudioBytesPerUtterance": 640000,
    "MaximumProviderAttempts": 1,
    "Conversation": {
      "Version": "voice-v1",
      "Language": "en-US",
      "VoiceId": "alloy",
      "SpeakingRate": 1.0,
      "Greeting": "Hello, thank you for calling PurpleGlass. How can I help you?",
      "OfficeName": "PurpleGlass development assistant",
      "OfficeHours": "not configured",
      "OfficeLocation": "not configured",
      "SafetyPolicyVersion": "voice-safety-v1",
      "AiAdapterKey": "deterministic",
      "SpeechRecognitionAdapterKey": "fake-speech",
      "SpeechSynthesisAdapterKey": "fake-speech",
      "MaximumTurns": 30,
      "InactivityTimeout": "00:00:30",
      "MaximumDuration": "00:30:00",
      "MaximumHistoryTurns": 12,
      "MaximumOutputTokens": 160,
      "MaximumResponseCharacters": 400,
      "SystemPrompt": "You represent the configured dental office or location on a phone call. Answer conversationally and keep spoken responses reasonably concise. Usually ask one useful question at a time. Do not invent office information or patient data. Do not claim an appointment was created or that any external action was performed. Do not diagnose dental conditions or pretend tools exist. Return plain conversational text without Markdown.",
      "ApprovedResponses": {},
      "EscalationKeywords": [],
      "UrgentKeywords": []
    }
  },
  "TwilioRealtimeAudio": {
    "MaxOutboundMediaBytes": 8192,
    "OutboundPacketDuration": "00:00:00.100",
    "EnableOutboundPacing": true
  },
  "Telephony": {
    "Provider": "None",
    "PublicBaseUrl": "",
    "InboundMessage": "Thank you for calling. PurpleGlass call transport is connected.",
    "OutboundMessage": "PurpleGlass call transport is connected.",
    "Twilio": {
      "AccountSid": "",
      "AuthToken": ""
    }
  },
  "Integrations": {
    "EnableOpenDental": false
  },
  "DataProtection": {
    "AllowSensitiveData": false
  }
}
