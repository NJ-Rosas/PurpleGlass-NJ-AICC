FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/backend/Hosts/PurpleGlass.Integrations.Worker/PurpleGlass.Integrations.Worker.csproj -c Release -o /out --no-self-contained

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine
WORKDIR /app
RUN apk add --no-cache busybox-extras krb5-libs tzdata
COPY --from=build /out ./
COPY deploy/render/start-free-worker.sh ./start-free-worker.sh
RUN mkdir -p /health/health && printf 'Healthy\n' > /health/health/live
EXPOSE 10000
ENTRYPOINT ["/bin/sh", "./start-free-worker.sh"]
